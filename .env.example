# ==============================================================================
# FLOWMIND AI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure secrets prior to deployment
# ==============================================================================

# PostgreSQL Database Connection URL (Prisma connection pool or main DB URI)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowmind_db?schema=public"

# Direct Database URL for Prisma migrations (optional for pooled environments like Supabase/Neon)
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowmind_db?schema=public"

# JWT Secret Key for Session Token verification (Minimum 32 random characters in production)
JWT_SECRET="super-secret-jwt-key-change-in-production-2026-flowmind"

# AES-256-GCM Master Encryption Key for BYOK Credentials (64-character Hex string = 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Session Cookie Name
SESSION_COOKIE_NAME="flowmind_session"

# Next.js Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment (production / development / test)
NODE_ENV="production"
