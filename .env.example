# PostgreSQL Database Connection URL (Prisma connection pool or main DB URI)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowmind_db?schema=public"

# Direct Database URL for Prisma migrations (optional for pooled environments like Supabase/Neon)
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowmind_db?schema=public"

# JWT Secret Key for Session Token verification
JWT_SECRET="super-secret-jwt-key-change-in-production-2026"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
