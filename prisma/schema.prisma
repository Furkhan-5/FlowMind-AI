// Prisma Schema for FlowMind AI PostgreSQL Backend

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum WorkflowStatus {
  DRAFT
  VALIDATED
  ACTIVE
  PAUSED
  DISABLED
  ARCHIVED
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  WAITING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum NodeExecutionStatus {
  PENDING
  READY
  RUNNING
  SUCCESS
  FAILED
  RETRYING
  TERMINAL_FAILURE
  SKIPPED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
  CANCELLED
}

enum AgentStatus {
  IDLE
  ACTIVE
  PROCESSING
}

enum AgentTaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  domain    String?
  logo      String?
  plan      String   @default("ENTERPRISE")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  workflows          Workflow[]
  workflowExecutions WorkflowExecution[]
  agents             Agent[]
  agentTasks         AgentTask[]
  approvalRequests   ApprovalRequest[]
  auditLogs          AuditLog[]
  artifacts          Artifact[]
  conversations      Conversation[]

  @@map("organizations")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  category    String   @default("SYSTEM")
  roles       String[]
  createdAt   DateTime @default(now())

  @@map("permissions")
}

model User {
  id                String     @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  email             String     @unique
  passwordHash      String
  role              UserRole   @default(EMPLOYEE)
  status            UserStatus @default(ACTIVE)
  avatar            String?
  preferredLanguage String     @default("en")
  resetToken        String?
  resetTokenExpiry  DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  createdWorkflows    Workflow[]          @relation("WorkflowCreator")
  triggeredExecutions WorkflowExecution[] @relation("ExecutionTriggerer")
  requestedApprovals  ApprovalRequest[]   @relation("ApprovalRequester")
  resolvedApprovals   ApprovalRequest[]   @relation("ApprovalResolver")
  auditLogs           AuditLog[]
  artifacts           Artifact[]
  conversations       Conversation[]
  messages            Message[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model Workflow {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  category       String         @default("GENERAL")
  naturalTrigger String?
  triggerType    String         @default("manual")
  triggerConfig  Json?
  status         WorkflowStatus @default(DRAFT)
  isTemplate     Boolean        @default(false)
  createdById    String?
  createdBy      User?          @relation("WorkflowCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  versions   WorkflowVersion[]
  executions WorkflowExecution[]

  @@index([organizationId])
  @@index([status])
  @@map("workflows")
}

model WorkflowVersion {
  id            String   @id @default(uuid())
  workflowId    String
  workflow      Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  versionNumber Int
  dagNodes      Json
  dagEdges      Json
  changeLog     String?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())

  executions WorkflowExecution[]

  @@unique([workflowId, versionNumber])
  @@index([workflowId])
  @@map("workflow_versions")
}

model WorkflowExecution {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId     String
  workflow       Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  versionId      String?
  version        WorkflowVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  triggeredById  String?
  triggeredBy    User?           @relation("ExecutionTriggerer", fields: [triggeredById], references: [id], onDelete: SetNull)
  triggerSource  String          @default("MANUAL")
  status         ExecutionStatus @default(QUEUED)
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  durationMs     Int?
  inputPayload   Json?
  outputResult   Json?
  logs           Json?
  errorMessage   String?

  nodeExecutions   WorkflowNodeExecution[]
  agentTasks       AgentTask[]
  approvalRequests ApprovalRequest[]

  @@index([organizationId])
  @@index([workflowId])
  @@index([status])
  @@map("workflow_executions")
}

model WorkflowNodeExecution {
  id           String              @id @default(uuid())
  executionId  String
  execution    WorkflowExecution   @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId       String
  nodeName     String
  nodeType     String
  agentType    String?
  status       NodeExecutionStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int?
  attempts     Int                 @default(1)
  inputData    Json?
  outputData   Json?
  errorMessage String?

  @@index([executionId])
  @@index([nodeId])
  @@map("workflow_node_executions")
}

model Agent {
  id                 String      @id
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  roleTitle          String
  domain             String
  status             AgentStatus @default(IDLE)
  description        String?
  avatarColor        String?
  tasksCompleted     Int         @default(0)
  systemPrompt       String?
  supportedLanguages Json?
  isEnabled          Boolean     @default(true)
  config             Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  tasks AgentTask[]

  @@index([organizationId])
  @@map("agents")
}

model AgentTask {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  executionId    String?
  execution      WorkflowExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  nodeId         String?
  prompt         String
  originalPrompt String?
  inputLanguage  String          @default("en")
  outputLanguage String          @default("en")
  response       String?
  status         AgentTaskStatus @default(PENDING)
  durationMs     Int?
  metadata       Json?
  createdAt      DateTime        @default(now())

  @@index([organizationId])
  @@index([agentId])
  @@map("agent_tasks")
}

model ApprovalRequest {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executionId    String?
  execution      WorkflowExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  nodeId         String?
  actionType     String
  actionPayload  Json
  riskLevel      String         @default("MEDIUM")
  status         ApprovalStatus @default(PENDING)
  requestedById  String?
  requestedBy    User?          @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById   String?
  approvedBy     User?          @relation("ApprovalResolver", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectReason   String?
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?

  @@index([organizationId])
  @@index([status])
  @@map("approval_requests")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail      String?
  action         String
  resourceType   String
  resourceId     String?
  details        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Artifact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           String
  mimeType       String?
  fileUrl        String?
  sizeBytes      Int?
  metadata       Json?
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("artifacts")
}

model Conversation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  title          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages Message[]

  @@index([organizationId])
  @@map("conversations")
}

model Message {
  id                String       @id @default(uuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            String
  userId            String?
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  activeAgent       String?
  content           String
  translatedContent Json?
  language          String       @default("en")
  thoughtStream     Json?
  actionCard        Json?
  confidenceLevel   String?
  riskLevel         String?
  timestamp         DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

// ================================================================
// WEEK 5 — BUSINESS OPERATIONS SUITE MODELS
// ================================================================

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Lead {
  id              String      @id @default(uuid())
  organizationId  String
  name            String
  email           String
  phone           String?
  company         String
  source          String      @default("WEBSITE")
  ownerId         String?
  stage           LeadStage   @default(NEW)
  status          String      @default("ACTIVE")
  score           Int         @default(50)
  value           Float       @default(0.0)
  tags            String[]
  notes           String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  stageHistory LeadStageHistory[]

  @@index([organizationId])
  @@index([stage])
  @@map("leads")
}

model LeadStageHistory {
  id            String   @id @default(uuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  previousStage String
  newStage      String
  changedBy     String
  reason        String?
  timestamp     DateTime @default(now())

  @@index([leadId])
  @@map("lead_stage_histories")
}

model Employee {
  id                String   @id @default(uuid())
  organizationId    String
  userId            String?
  employeeCode      String   @unique
  name              String
  email             String   @unique
  department        String
  designation       String
  managerId         String?
  joiningDate       DateTime @default(now())
  employmentStatus  String   @default("ACTIVE")
  salary            Float    @default(0.0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  leaveRequests  LeaveRequest[]
  payrollRecords PayrollRecord[]

  @@index([organizationId])
  @@index([department])
  @@map("employees")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id             String      @id @default(uuid())
  organizationId String
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      String
  startDate      DateTime
  endDate        DateTime
  reason         String
  status         LeaveStatus @default(PENDING)
  approverId     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([organizationId])
  @@index([employeeId])
  @@map("leave_requests")
}

model PayrollRecord {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period         String
  baseSalary     Float
  allowances     Float    @default(0.0)
  deductions     Float    @default(0.0)
  bonuses        Float    @default(0.0)
  grossSalary    Float
  netSalary      Float
  status         String   @default("PROCESSED")
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([employeeId])
  @@map("payroll_records")
}

enum InvoiceStatus {
  DRAFT
  PENDING
  APPROVED
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String
  invoiceNumber  String        @unique
  customerId     String?
  customerName   String
  customerEmail  String?
  createdById    String?
  status         InvoiceStatus @default(PENDING)
  subtotal       Float
  tax            Float         @default(0.0)
  discount       Float         @default(0.0)
  total          Float
  dueDate        DateTime
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([organizationId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  amount      Float

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id             String   @id @default(uuid())
  organizationId String
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Float
  paymentMethod  String   @default("BANK_TRANSFER")
  status         String   @default("COMPLETED")
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

model Product {
  id             String   @id @default(uuid())
  organizationId String
  sku            String   @unique
  name           String
  description    String?
  category       String
  quantity       Int      @default(0)
  reorderLevel   Int      @default(10)
  unitPrice      Float
  status         String   @default("IN_STOCK")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stockMovements StockMovement[]

  @@index([organizationId])
  @@index([sku])
  @@map("products")
}

model StockMovement {
  id             String   @id @default(uuid())
  organizationId String
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Int
  movementType   String   // STOCK_IN, STOCK_OUT, ADJUSTMENT, TRANSFER
  reference      String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([productId])
  @@map("stock_movements")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

model SupportTicket {
  id             String         @id @default(uuid())
  organizationId String
  ticketNumber   String         @unique
  customerId     String?
  customerName   String
  title          String
  description    String
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  category       String         @default("GENERAL")
  assignedToId   String?
  createdById    String?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  notes TicketNote[]

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

model TicketNote {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    String
  note      String
  isInternal Boolean      @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@map("ticket_notes")
}
